# Kopieer dit bestand naar .env en vul de waarden in.

# Verplicht: je bot-token (Discord Developer Portal -> jouw app -> Bot -> Reset Token)
DISCORD_TOKEN=

# Aanbevolen: ID van je server. Zet je dit neer, dan staan de /-commands er
# meteen op. Zonder dit kan het tot een uur duren voor Discord ze toont.
GUILD_ID=

# Rol-ID van de staf: deze rol ziet alle tickets en mag ze claimen/sluiten.
STAFF_ROLE_ID=

# Categorie-ID waar de ticketkanalen in komen. Leeg = bovenaan de server.
TICKET_CATEGORY_ID=

# Kanaal-ID waar de transcripts van gesloten tickets naartoe gaan.
TICKET_LOG_CHANNEL_ID=

# Kanaal-ID waar nieuwe leden automatisch worden begroet.
WELCOME_CHANNEL_ID=

# Optioneel: link (https) naar de banner/afbeelding in het welkomstbericht.
WELCOME_IMAGE_URL=

# Rol-ID die nieuwe leden automatisch krijgen. Leeg = de standaard uit de code
# (1459910402799435909). Zet hier een andere ID om een andere rol te geven.
AUTO_ROLE_ID=

# Database (optioneel). Zet je deze, dan bewaart de bot tickets, opkomst, agenda,
# instellingen en ticketsoorten in MySQL/MariaDB in plaats van data/*.json.
# Laat ze leeg om met de bestanden te werken.
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
